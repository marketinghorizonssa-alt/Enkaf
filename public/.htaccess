Options -Indexes
RewriteEngine On

# ENKAF Google Tag Manager container.
<IfModule mod_env.c>
  SetEnv ENKAF_GTM_ID GTM-KR7SJ5H9
</IfModule>

# Force canonical crawl-control routes through PHP before existing-file checks.
RewriteRule ^robots\.txt$ index.php [L,QSA]
RewriteRule ^sitemap\.xml$ index.php [L,QSA]

# Block private application directories if the document root is ever misconfigured.
RewriteRule ^(?:app|private|docs|scripts)(?:/|$) - [F,L]

# Serve real public assets/files directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all application URLs to the front controller.
RewriteRule ^ index.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
