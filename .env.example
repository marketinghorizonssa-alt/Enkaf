# Production target / staging target
ENKAF_SITE_URL=https://enkaf.sa

# Keep true until production review is approved.
ENKAF_REVIEW_MODE=true

# Set only after a dedicated ENKAF GTM container is created and verified.
ENKAF_GTM_ID=

# Must point outside public web root in production.
ENKAF_DATA_DIR=/home/USER/domains/enkaf.sa/enkaf-private

# Secret token for private CSV feed consumed by the approved Google Sheet.
ENKAF_FEED_TOKEN=
